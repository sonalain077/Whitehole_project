root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2

# Supplied raw data must not be reformatted by an editor.
[{news.json,sp500.csv}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
